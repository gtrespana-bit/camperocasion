+  label: string
+  icon: string
+  slug: string
+  subs: CatSub[]
+}
+
+let _anos: string[] | undefined
+function aniosSelect(): string[] {
+  if (!_anos) {
+    const c = new Date().getFullYear()
+    _anos = Array.from({ length: 30 }, (_, i) => String(c - i))
+  }
+  return _anos
+}
