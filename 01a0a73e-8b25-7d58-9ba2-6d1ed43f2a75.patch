+}
+
+export type Producto = {
+  id: string
+  slug?: string | null
+  user_id: string
+  titulo: string | null
+  descripcion?: string | null
+  precio_usd?: number | string | null
+  categoria_id?: number | null
+  subcategoria?: string | null
+  marca?: string | null
+  modelo?: string | null
