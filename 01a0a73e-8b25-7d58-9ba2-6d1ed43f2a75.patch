+              <button onClick={() => rechazarSol(rechazoModal)} className="flex-1 px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 font-bold">Rechazar</button>
+            </div>
+          </div>
+        </div>
+      )}
+    </div>
+  )
+}
