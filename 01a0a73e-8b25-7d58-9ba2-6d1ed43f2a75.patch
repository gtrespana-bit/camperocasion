+    const params = filtro !== 'todas' ? `?estado=${encodeURIComponent(filtro)}` : ''
+    const res = await fetch(`/api/admin/solicitudes-verificacion${params}`, { cache: 'no-store' })
+    const result = await res.json().catch(() => ({}))
