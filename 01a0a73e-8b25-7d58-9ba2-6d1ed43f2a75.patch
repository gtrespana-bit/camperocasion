+          >
+            Enviar otro mensaje
+          </button>
+        </div>
+      </div>
+    )
+  }
+
+  return (
+    <div className="max-w-4xl mx-auto px-4 py-12">
+      <h1 className="text-4xl font-black text-gray-800 mb-2 text-center">{t('title')}</h1>
