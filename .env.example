# ─────────────────────────────────────────────────────────────
# CamperOcasión — plantilla de variables de entorno
# Copiar a `.env` para desarrollo local (`cp .env.example .env`).
# En producción se definen en Vercel → Project → Settings →
# Environment Variables. NUNCA subir a Git un `.env` con claves reales.
# ─────────────────────────────────────────────────────────────

# ── OBLIGATORIAS ─────────────────────────────────────────────
# Sin estas dos el build de Vercel pasa, pero el sitio sale vacío
# (las páginas públicas se renderizan sin datos por diseño).
# URL del proyecto: es la que ya está fijada en next.config.js (hosts de
# imágenes permitidos) y en el <link rel=preconnect> de src/app/layout.tsx.
# La anon key: Supabase → Project Settings → API Keys.
#   · Recomendado en 2026: pestaña "Publishable and secret API keys" →
#     `sb_publishable_…` (sustituye a anon) y `sb_secret_…` (sustituye a
#     service_role). Se pegan en las MISMAS variables de abajo; el código no
#     cambia, las envía supabase-js.
#   · Pestaña "Legacy API keys" → `anon` (JWT eyJ…) y `service_role`: siguen
#     funcionando, pero Supabase las retira a finales de 2026.
# Ojo: el "JWT Secret" (Settings → API → JWT Settings) NO es una API key.
# Cada proyecto de Supabase tiene su propia URL y sus propias claves: si
# mezclas la URL de un proyecto con la clave de otro, Supabase responde
# `401 Invalid API key` en todo el sitio (el diagnóstico está en
# docs/diagnostico-supabase-401.md).
NEXT_PUBLIC_SUPABASE_URL=https://hbiywrddxrsidniwxuhe.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...   # o sb_publishable_...

# ── PRODUCCIÓN / SERVIDOR (no exponer al cliente) ────────────
# service_role: sortea RLS. Solo server-side; si la pones como
# NEXT_PUBLIC_ estarías dando acceso total a la base de datos.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...       # o sb_secret_...

# Dominio canónico: enlaces de emails, OG, sitemaps, redirects.
NEXT_PUBLIC_URL=https://camperocasion.online

# Protege las 4 rutas de /api/cron/* (Vercel envía Authorization: Bearer).
# Sin CRON_SECRET las rutas devuelven 401 y los cron no hacen nada.
CRON_SECRET=cambia-esto-por-un-string-aleatorio-largo

# ── CUENTAS Y NOTIFICACIONES (opcionales) ────────────────────
# Emails transaccionales (verificación, recovery, digest).
RESEND_API_KEY=
EMAIL_FROM="CamperOcasión <no-reply@camperocasion.online>"
CONTACTO_EMAIL=soporte@camperocasion.online   # default del código: /api/contacto

# SMTP alternativo/respaldo (Zoho).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# ── COBRO DE CRÉDITOS (Bizum / transferencia / PayPal) ───────
# ⚠️ SIN ESTAS VARIABLES NO SE PUEDE COBRAR. La página /creditos oculta los
# métodos que no estén configurados: si no hay ninguno, muestra un aviso en vez
# de datos bancarios inventados (antes rellenaba con un IBAN de ejemplo y el
# comprador podía ingresar en una cuenta que no existe).
# PAGO_RECEPTOR       → titular que ve el comprador (p. ej. "CamperOcasión SL")
# PAGO_IBAN           → IBAN de la cuenta de cobro (transferencia)
# PAGO_BIZUM_TELEFONO → teléfono de Bizum, sin espacios (p. ej. 600123456)
# PAGO_PAYPAL_EMAIL   → cuenta de PayPal que recibe el pago
PAGO_RECEPTOR=
PAGO_IBAN=
PAGO_BIZUM_TELEFONO=
PAGO_PAYPAL_EMAIL=
# Opcionales: banco (solo informativo) y nota extra para el comprador.
PAGO_BANCO=
PAGO_INSTRUCCIONES=

# Admin del panel /api/admin/* — coma-separado.
ADMIN_EMAILS=gtrespana@gmail.com
NEXT_PUBLIC_ADMIN_EMAILS=gtrespana@gmail.com

# Avisos al móvil (reservas, comprobantes). Sin esto todo sigue funcionando.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Push notifications (PWA). Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# R2 (Cloudflare). La SUBIDA va por Supabase Storage (/api/storage-upload);
# R2 solo interviene al borrar fotos antiguas en /api/admin/eliminar-producto
# y en los hosts de next/image. Si no miglaste fotos a R2, deja todo esto vacío.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Search Console: propiedad de verificación (meta tag).
GOOGLE_SITE_VERIFICATION=

# ── NO existen / NO poner en Vercel ────────────────────────
# SUPABASE_SERVICE_KEY → alias legado que solo usan los scripts de scripts/.
# EMAIL_SERVER_HOST    → no la usa ningún envío; solo /api/admin/status.
# NEXT_OUTPUT=standalone → ROMPE la build en Vercel. Solo para self-hosting
#   con `npm run build:standalone` (Docker / node .next/standalone/server.js).

